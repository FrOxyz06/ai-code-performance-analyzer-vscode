{
  "name": "performance-analyzer-vscode",
  "version": "0.4.0",
  "displayName": "Performance Analyzer",
  "description": "Profile Python functions, compare behavior/runtime/allocations, and export reproducible reports.",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "performanceAnalyzer.askCopilot",
        "title": "Performance Analyzer: Ask Copilot"
      },
      {
        "command": "performanceAnalyzer.analyzeFile",
        "title": "Performance Analyzer: Compare File"
      },
      {
        "command": "performanceAnalyzer.profileFile",
        "title": "Performance Analyzer: Profile File"
      },
      {
        "command": "performanceAnalyzer.exportReport",
        "title": "Performance Analyzer: Export Report"
      }
    ],
    "configuration": {
      "title": "Performance Analyzer",
      "properties": {
        "performanceAnalyzer.pythonPath": {
          "type": "string",
          "default": "python",
          "scope": "machine",
          "description": "Python 3.10+ executable path (no command-line arguments)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:editor": "npm run compile && node scripts/run-editor-tests.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FrOxyz06/ai-code-performance-analyzer-vscode.git"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Code execution and applying proposals require workspace trust."
    },
    "virtualWorkspaces": false
  }
}
